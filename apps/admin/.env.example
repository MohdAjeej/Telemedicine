# API Configuration
# For development, use relative URLs (proxy through Vite):
# VITE_API_BASE_URL=/api/v1
# VITE_SOCKET_URL=/

# For production, use absolute URLs to your deployed server:
VITE_API_BASE_URL=http://YOUR_SERVER_IP:5002/api/v1
VITE_SOCKET_URL=http://YOUR_SERVER_IP:5002

# Shared login page (apps/client) — where a signed-out admin is sent back to,
# since that's the one page every role signs in from.
VITE_CLIENT_URL=http://YOUR_SERVER_IP:8080
