# API Configuration
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=/

# Standalone Admin Console (apps/admin) — where new hospital admins are sent
# after registering, since /app/admin no longer exists in this app.
VITE_ADMIN_CONSOLE_URL=http://localhost:5174

# WebRTC TURN Server Configuration
# Multiple TURN servers are pre-configured in the application for maximum connectivity:
# - STUN servers (Google + Metered.ca) for NAT traversal
# - TURN servers on port 80 (UDP/TCP) for standard networks
# - TURN servers on port 443 (UDP/TLS) to bypass firewalls
#
# Only provide username and password - server URLs are hardcoded for reliability
# Free tier from Metered.ca: 50GB/month bandwidth

VITE_TURN_USERNAME=your-metered-username
VITE_TURN_PASSWORD=your-metered-password

# For development with Metered.ca free tier, use:
# VITE_TURN_USERNAME=108d22b8b751c94340dd72ec
# VITE_TURN_PASSWORD=AQZSLFQEvZ8CyS0S
