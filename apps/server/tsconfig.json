{
  "extends": "../../packages/config/typescript/node.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/tests"],
  "ts-node": {
    "transpileOnly": true,
    "ignore": ["(?:^|/)node_modules/(?!@telemedicine)"]
  }
}
