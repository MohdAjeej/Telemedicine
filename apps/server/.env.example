NODE_ENV=production
PORT=5002
CLIENT_URL=http://YOUR_SERVER_IP:8080

MONGO_URI=mongodb://YOUR_SERVER_IP:27019/telemedicine

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=telemedicine_refresh_token

# Signs the one-time ticket that hands an admin from the client app's login page
# straight into the Admin Console without a second password entry.
ADMIN_HANDOFF_SECRET=change-me-admin-handoff-secret
ADMIN_HANDOFF_EXPIRES_IN=60s

BCRYPT_SALT_ROUNDS=12

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

LOG_LEVEL=info
